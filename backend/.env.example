# Server
PORT=4000
HOST=0.0.0.0

# SQLite
DB_PATH=./data/gigvault.db

# AA adapter: "mock" (default, signed synthetic FIP) or "sandbox" (real AA sandbox creds)
AA_PROVIDER=mock

# Only used if AA_PROVIDER=sandbox — fill in from your actual sandbox registration.
# Leaving these unset is fine while AA_PROVIDER=mock; nothing reads them in that mode.
AA_SANDBOX_BASE_URL=
AA_SANDBOX_CLIENT_ID=
AA_SANDBOX_CLIENT_SECRET=

# Mock FIP signing key (Ed25519, base64). A dev default is generated on first run if unset
# and written to data/.mock-fip-key — do not reuse that generated key past the hackathon.
MOCK_FIP_SIGNING_KEY=

# Circuit artifacts (produced by `npm run circuit:build`)
CIRCUIT_WASM_PATH=./circuits/build/gigvault_js/gigvault.wasm
CIRCUIT_ZKEY_PATH=./circuits/build/gigvault_final.zkey
CIRCUIT_VKEY_PATH=./circuits/build/verification_key.json

# Anon Aadhaar identity binding: "mock" (default, structural check only — NOT an
# identity check) or "real" (verifies via @anon-aadhaar/core, which you must install
# separately). "mock" throws on startup of any request if NODE_ENV=production.
ANON_AADHAAR_MODE=mock

# Presentation challenge lifetime, seconds. This is the window in which a rider taps to
# approve a verifier's check, not a session length — keep it short.
PRESENTATION_TTL_SECONDS=120

# ---- Anon Aadhaar (real mode) ----
# ANON_AADHAAR_MODE=real
# ANON_AADHAAR_USE_TEST=1            # 1 = accept proofs from the SDK's TEST Aadhaar cert (demo); 0 = real UIDAI cert
# ANON_AADHAAR_VKEY_PATH=            # absolute path to a pre-downloaded v2.0.0 vkey.json => no network needed at verify time

# ---- Chain (Entry 3: commitment on chain) ----
# CHAIN_MODE=on                      # default off => SQLite-only demo, no chain needed
# CHAIN_NETWORK=localhost            # reads ../deployments/<network>.json written by contracts deploy script
# CHAIN_RPC_URL=http://127.0.0.1:8545   # for amoy: your Amoy RPC
# OPERATOR_PRIVATE_KEY=              # default = hardhat account #0 (local only!). MUST be the deployer key on Amoy (Admission is Ownable).
